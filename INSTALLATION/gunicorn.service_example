[Unit]
Description=Gunicorn instance to serve Cratos application
After=network.target

[Service]
User=fastapi
Group=fastapi
WorkingDirectory=/opt/cratos-fastapi
Environment="PATH=/opt/cratos-fastapi/.venv/bin"
# Reference gunicorn_config.py rather than duplicating flags here - keeps bind address,
# worker count, reload, and proxy settings in one place instead of two configs drifting
# out of sync with each other.
ExecStart=/opt/cratos-fastapi/.venv/bin/gunicorn app.main:app --config /opt/cratos-fastapi/gunicorn_config.py
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
